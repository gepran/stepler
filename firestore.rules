rules_version = '2';

// Stepler — a task lives under the user who owns it, and nothing is readable
// across accounts. The client is never trusted to say who it is: the only uid
// that matters is the one Firebase Auth put in the token.
//
// Collaboration adds the only three places where two accounts meet: a public
// profile card, the handle that names it, and the two subcollections that carry
// an invitation and a mention. Each of those is written under a rule narrow
// enough that the worst a hostile client can do is write the one document that
// represents itself.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Ordering between devices is decided by the server clock, not by whichever
    // laptop has the most confident idea of what time it is.
    function stampedByServer() {
      return request.resource.data.updatedAt == request.time;
    }

    function isString(field, maxLen) {
      return request.resource.data[field] is string
        && request.resource.data[field].size() <= maxLen;
    }

    // A task carries a little more than the desktop version stores: the day it
    // belongs to, a tombstone flag so a delete can travel between devices, and
    // the server stamp above.
    function validTask() {
      return isString('id', 64)
        && isString('text', 20000)
        && isString('ymd', 10)
        && request.resource.data.completed is bool
        && request.resource.data.deleted is bool
        && stampedByServer();
    }

    // Two people are connected only when BOTH sides say so. Reading the far
    // side's row is what stops an invitation nobody accepted from being a
    // licence to write into that person's list.
    //
    // A ternary rather than `exists(x) && get(x)`: `&&` evaluates both of its
    // operands, so the `get` of a document that is not there raises instead of
    // returning false. The write is denied either way, but a rule that throws
    // is a rule nobody can read the intent of afterwards.
    function connectionPath(owner, other) {
      return /databases/$(database)/documents/users/$(owner)/connections/$(other);
    }

    function acceptedWith(owner, other) {
      return exists(connectionPath(owner, other))
        ? get(connectionPath(owner, other)).data.status == 'accepted'
        : false;
    }

    // The handle a person actually holds, or "" if they hold none. Same
    // ternary, same reason.
    function handleHolder(handle) {
      return exists(/databases/$(database)/documents/usernames/$(handle))
        ? get(/databases/$(database)/documents/usernames/$(handle)).data.uid
        : "";
    }

    // Am I named on this task? The proof is the mention sitting in MY OWN
    // space, which only the author could have put there — so a mention nobody
    // sent me is not something I can forge into write access.
    function mentionPath(taskId) {
      return /databases/$(database)/documents/users/$(request.auth.uid)/mentions/$(taskId);
    }

    function mentionedOn(author, taskId) {
      return exists(mentionPath(taskId))
        ? get(mentionPath(taskId)).data.fromUid == author
        : false;
    }

    // Exactly which fields a write moved. `updatedAt` rides along on every
    // write, so it is always in the permitted set.
    function onlyTouches(fields) {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(fields.concat(['updatedAt']));
    }

    // ---------------------------------------------------------------------
    // Public identity
    //
    // A profile card is the only thing in this database any signed-in user can
    // read about another, and it holds exactly what you need to decide whether
    // the @handle you are about to type is the person you meant.
    // ---------------------------------------------------------------------

    match /profiles/{uid} {
      allow read: if signedIn();
      // The handle on the card has to be one this account has actually claimed
      // in /usernames. Without that check the lock below would be decorative:
      // anybody could write @somebody-else onto their own card and turn up in
      // that person's place in every search box.
      allow write: if signedInAs(uid)
        && isString('username', 24)
        && isString('usernameLower', 24)
        && request.resource.data.username == request.resource.data.usernameLower
        && handleHolder(request.resource.data.usernameLower) == uid
        && stampedByServer();
    }

    // The handle itself, as its own document so the id enforces uniqueness:
    // a create fails if somebody already holds the name, which is the whole
    // point of the collection. Nobody can take a name off somebody else —
    // an update or a delete has to come from the uid already recorded in it.
    match /usernames/{handle} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && stampedByServer();
      allow update, delete: if signedIn()
        && resource != null
        && resource.data.uid == request.auth.uid;
    }

    // An address is a lookup key, never a listing. `get` is allowed so somebody
    // who was given a colleague's address can find the account behind it; `list`
    // is denied outright, so the collection cannot be walked. That distinction
    // is the whole point: /profiles allows `list`, which is why the address must
    // not live there — one throwaway account could page out every address in the
    // database.
    //
    // The document id has to be the address on the caller's own token, so an
    // account cannot point somebody else's address at itself and turn up in
    // their place when that address is searched.
    match /emails/{address} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.auth.token.email is string
        && address == request.auth.token.email.lower()
        && stampedByServer();
      allow delete: if signedIn()
        && resource != null
        && resource.data.uid == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if signedInAs(uid);
      allow write: if signedInAs(uid) && stampedByServer();

      match /tasks/{taskId} {
        allow read: if signedInAs(uid);
        allow create: if signedInAs(uid) && validTask();

        // Somebody you named in a task can work on it with you, within limits
        // that are enforced here rather than by the interface: they may tick
        // it off, star it, and add or tick subtasks. They may not touch the
        // words — those are yours — and the delete rule below never widens, so
        // a task can only ever be thrown away by the person who wrote it.
        //
        // A ternary rather than two branches joined by `||`. Rules evaluate
        // both sides of `||` and `&&`, so an owner's write would also run the
        // mentioned-person branch — paying for a document read on every
        // keystroke-sized save — and a stranger's write would run validTask()
        // against fields it has no business having, which raises rather than
        // returning false. Whose write this is decides which question to ask.
        allow update: if signedInAs(uid)
          ? validTask()
          : (
              signedIn()
              && resource != null
              && mentionedOn(uid, taskId)
              && onlyTouches(['completed', 'priority', 'subtasks'])
              && stampedByServer()
            );

        // A task is never really removed — it is tombstoned, so the other
        // devices learn about the delete instead of resurrecting the task on
        // their next sync.
        allow delete: if signedInAs(uid);
      }

      // -------------------------------------------------------------------
      // Invitations
      //
      // Your own list is yours to write. Somebody else may write exactly one
      // document in it — the one whose id is their own uid, the row that
      // represents them — which is how an invitation reaches you and how your
      // acceptance reaches them. They can never touch the row describing
      // anybody else, and never read the list at all.
      // -------------------------------------------------------------------
      match /connections/{otherUid} {
        allow read: if signedInAs(uid);
        // Your own list is yours to write. Somebody else may write exactly one
        // document in it — the row that represents THEM — and the identity on
        // that row now has to be one they can prove. Without the handle check
        // an invitation could arrive wearing a colleague's name, and it is the
        // name on this row that `resolveMentions` matches when it decides who
        // to deliver your tasks to: your own client would post them to whoever
        // sent the row.
        allow create, update: if signedInAs(uid)
          ? true
          : (
            signedInAs(otherUid)
            && stampedByServer()
            && request.resource.data.uid == request.auth.uid
            && handleHolder(request.resource.data.usernameLower) == request.auth.uid
          );
        allow delete: if signedInAs(uid) || signedInAs(otherUid);
      }

      // -------------------------------------------------------------------
      // Mentions
      //
      // A copy of the task, written into the mentioned person's own space by
      // whoever wrote the task — but only once both sides have accepted each
      // other, so a mention cannot be used to push text at a stranger. The
      // owner may write their own copy too, which is how "read" gets ticked.
      // -------------------------------------------------------------------
      match /mentions/{mentionId} {
        allow read: if signedInAs(uid);

        // Only the AUTHOR may put a mention in somebody's list. The owner used
        // to be allowed here too, and that was the hole: `mentionedOn` treats
        // this document as proof that its `fromUid` mentioned you, so an
        // account that could write its own mentions could name anybody as the
        // author and cash that in for write access to that person's task.
        allow create: if signedIn()
          && request.resource.data.fromUid == request.auth.uid
          && isString('text', 20000)
          && isString('taskId', 64)
          && stampedByServer()
          && acceptedWith(uid, request.auth.uid);

        // Two different updates. You may tick your copy off and mark it read;
        // the author may revise what they said. Neither may rewrite who it
        // came from, which is the field the task rule above trusts.
        allow update: if resource == null
          ? false
          : (
          signedInAs(uid)
            ? (
                onlyTouches(['read', 'dismissed', 'completed', 'priority', 'subtasks'])
                && request.resource.data.fromUid == resource.data.fromUid
              )
            : (
                signedIn()
                && resource.data.fromUid == request.auth.uid
                && request.resource.data.fromUid == request.auth.uid
                && isString('text', 20000)
                && isString('taskId', 64)
                && stampedByServer()
              )
        );

        // Either end can take a mention back: the author when they stop
        // mentioning you, and you when you have finished with it.
        allow delete: if signedInAs(uid)
          || (signedIn()
              && resource != null
              && resource.data.fromUid == request.auth.uid);
      }

      // Settings and sync bookkeeping. Shape is left open on purpose; these
      // documents are small and only ever read by their own owner.
      match /meta/{docId} {
        allow read: if signedInAs(uid);
        allow write: if signedInAs(uid) && stampedByServer();
      }
    }

    // Anything not matched above is denied, which is the Firestore default and
    // is spelled out here so it stays a decision rather than an oversight.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
