{
  "name": "stepler",
  "version": "1.3.18",
  "description": "Stepler — a fast daily task timeline for macOS and Windows",
  "main": "./out/main/index.js",
  "bin": {
    "stepler": "./stepler-cli.mjs"
  },
  "author": "gepran",
  "homepage": "https://github.com/gepran/stepler",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win --x64",
    "build:mac": "npm run build && electron-builder --mac --universal",
    "build:linux": "npm run build && electron-builder --linux",
    "cli": "node stepler-cli.mjs",
    "dev:web": "vite --config vite.web.config.mjs",
    "build:web": "vite build --config vite.web.config.mjs",
    "deploy:web": "npm run build:web && firebase deploy --only hosting:web",
    "prebuild:web": "node scripts/sync-download-links.mjs",
    "test": "node --test tests/projects-and-drag.test.mjs tests/sync-data.test.mjs tests/concurrent-edits.test.mjs tests/project-sync.test.mjs tests/subtask-queue.test.mjs tests/sync-recovery.test.mjs functions/test/report-service.test.mjs functions/test/mention-attachments.test.mjs",
    "test:rules": "node --test tests/firestore-rules.test.mjs",
    "test:firebase": "firebase emulators:exec --only firestore,storage,auth --project demo-stepler-review --config firebase.test.json \"node --test tests/firestore-rules.test.mjs tests/storage-rules.test.mjs functions/test/report-endpoint.test.mjs\"",
    "test:desktop": "npm run build && electron tests/desktop.cjs",
    "test:all": "npm run lint && npm test && npm run test:firebase && npm run test:desktop && npm run build:web",
    "test:ios": "node scripts/ios.mjs test",
    "build:ios": "node scripts/ios.mjs build",
    "install:ios": "node scripts/ios.mjs install",
    "deploy:reports": "firebase deploy --only functions:reports",
    "deploy:report-intake": "node scripts/deploy-report-intake.mjs",
    "verify:update": "node scripts/verify-update-artifacts.mjs"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "dotenv": "^17.3.1",
    "electron-updater": "^6.8.3",
    "firebase": "^12.18.0",
    "googleapis": "^171.4.0",
    "lucide-react": "^0.575.0",
    "prop-types": "^15.8.1",
    "react-syntax-highlighter": "^16.1.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config": "^2.1.0",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@tailwindcss/vite": "^4.2.0",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.24",
    "electron": "^44.5.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.2.0",
    "vite": "^7.2.6",
    "js-yaml": "^4.3.2"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.14.5"
    },
    "brace-expansion@^2.0.1": "^2.1.7"
  }
}
